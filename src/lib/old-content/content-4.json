                }
            ]
        },
        {
            "id": "picked-up-stone",
            "title": "A Magic Stone?",
            "description": "You pick up the stone. It feels cold to the touch, yet somehow also seems to heat you up.",
            "options": [
                {
                    "action": "Put the stone in your pocket",
                    "state": "has-stone"
                }
            ]
        },
        {
            "id": "has-stone",
            "title": "A Magic Stone?",
            "description": "Shrugging, you decide to put it in your pocket.",
