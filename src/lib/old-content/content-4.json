            ],
            "options": [
                {
                    "action": "Go back and check the stone area",
                    "state": "explore-1",
                    "reqs": {
                        "no-flags": ["has-stone"]
                    }
                },
                {
                    "action": "Try to open the metallic door",
                    "state": "corridor-entrance"
                },
                {
                    "action": "Touch the door with the Cold Stone",
                    "state": "door-open",
                    "reqs": {
