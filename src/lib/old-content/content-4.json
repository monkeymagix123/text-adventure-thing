            "description": "Welcome to the game",
            "options": [
                {
                    "action": "Play",
                    "state": "start"
                }
            ]
        },
        {
            "id": "start",
            "title": "Start",
            "description": "You wake up in a dark room. The air is still and heavy. Somehow, you feel like you've been here before. There's not quite anything to do at the moment, so you might as well explore.",
            "req-desciptions": [
                {
                    "reqs": {
                        "flags": ["played-once"]
                    },
                    "description": "You wake up again in the dark room. The silence is deafening. You know the drill by now."
                }
            ],
            "options": [
                {
                    "action": "Explore",
                    "state": "explore-1"
                },
                {
                    "action": "Gaze into the darkness",
                    "state": "looked-around-basic"
                },
                {
                    "action": "Sit down",
                    "state": "sat-down"
                }
            ],
            "on-exit": {
                "unlock-flags": ["played-once"]
            }
        },
        {
            "id": "sat-down",
            "title": "Sat Down",
            "description": "You sit down, expecting to feel the cold floor beneath your feet. But instead, you find yourself in another dark room. Again.",
            "req-desciptions": [
                {
                    "reqs": {
                        "flags": ["temp-system-active"]
                    },
                    "description": "You sit down. Because you activated the glyphs, the room's dimensional stabilizers are working. You do not teleport away. Instead, you catch your breath. On the floor, illuminated by the now-active glyphs, you see a scratched message: 'The stone is the key, but the mind is the map.'"
                }
            ],
            "options": [
                {
                    "action": "Stand up and continue",
                    "state": "start",
                    "reqs": {
                        "flags": ["temp-system-active"]
                    }
                },
                {
                    "action": "Accept your fate (Reset)",
                    "state": "start",
                    "resetFlags": true,
                    "reqs": {
                        "no-flags": ["temp-system-active"]
                    }
                }
            ],
            "on-enter": {
                "resetFlags": true,
                "reqs": {
                    "no-flags": ["temp-system-active"]
                }
            }
        },
        {
            "id": "looked-around-basic",
            "title": "Looking Around?",
            "description": "As you look around, an unknown force suddenly strikes you. You have no choice but to give up and submit to the darkness.",
            "req-desciptions": [
                {
                    "reqs": {
                        "flags": ["has-stone"]
                    },
                    "description": "The shadows hiss and retreat! The stone protects you. It is safe to look around for a moment."
                },
                {
                    "reqs": {
                        "flags": ["temp-system-active"],
                        "no-flags": ["has-stone"]
                    },
                    "description": "The darkness tries to envelop you, but the green light from the active puzzle glyphs keeps the worst of the shadows at bay. You can barely see, but you are safe for now."
                }
            ],
            "options": [
                {
                    "action": "Give up",
                    "state": "start",
                    "resetFlags": true,
                    "reqs": {
                        "no-flags": ["has-stone", "temp-system-active"]
                    }
                },
                {
                    "action": "Return to exploring",
                    "state": "explore-1",
                    "reqs": {
                        "flags": ["has-stone"]
                    }
                },
                {
                    "action": "Retreat to the glowing glyphs",
                    "state": "explore-2",
                    "reqs": {
                        "flags": ["temp-system-active"],
                        "no-flags": ["has-stone"]
                    }
                }
            ]
        },
        {
            "id": "game-over",
            "title": "Game Over",
            "description": "You have been slain.",
            "options": [
                {
                    "action": "Restart",
                    "state": "start",
                    "resetFlags": true
                }
            ]
        },
        {
            "id": "explore-1",
